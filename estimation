                <span>{submitError}</span>
              </div>
            )}
            
            <input
              type="text"
              value={formData.firstName}
              onChange={(e) => setFormData({ ...formData, firstName: e.target.value })}
              className="w-full p-4 border border-gray-300 rounded"
              placeholder={t.firstName + ' *'}
              required
            />
            <input
              type="text"
              value={formData.lastName}
              onChange={(e) => setFormData({ ...formData, lastName: e.target.value })}
              className="w-full p-4 border border-gray-300 rounded"
              placeholder={t.lastName + ' *'}
              required
            />
            <input
              type="email"
              value={formData.email}
              onChange={(e) => setFormData({ ...formData, email: e.target.value })}
              className="w-full p-4 border border-gray-300 rounded"
              placeholder={t.email + ' *'}
              required
            />
            <input
              type="tel"
              value={formData.phone}
              onChange={(e) => setFormData({ ...formData, phone: e.target.value })}
              className="w-full p-4 border border-gray-300 rounded"
              placeholder={t.phone + ' *'}
              required
            />
            <textarea
              value={formData.comments}
              onChange={(e) => setFormData({ ...formData, comments: e.target.value })}
              className="w-full p-4 border border-gray-300 rounded h-32"
              placeholder={t.commentsPlaceholder}
            />
            <button
              onClick={handleSubmit}
              disabled={!formData.firstName || !formData.lastName || !formData.email || !formData.phone || isSubmitting}
              className="w-full bg-red-600 text-white py-4 rounded hover:bg-red-700 transition disabled:bg-gray-400 disabled:cursor-not-allowed flex items-center justify-center gap-2"
            >
              {isSubmitting ? (
                <>
                  <Loader2 size={20} className="animate-spin" />
                  {t.submitting}
                </>
              ) : (
                t.submit
              )}
            </button>
          </div>
        );

